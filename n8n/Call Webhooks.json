    {
      "parameters": {
        "jsCode": "const normalized = $json;\n\n// Read the complete original ElevenLabs webhook,\n// not only the normalized fields from \"Get data\"\nconst webhook = $('ElevenLabs Post Call Webhook').item.json;\n\nconst data = webhook.body?.data ?? {};\nconst metadata = data.metadata ?? {};\nconst transcript = Array.isArray(data.transcript)\n  ? data.transcript\n  : [];\n\n// Voicemail system-tool result\nconst voicemailUsed =\n  normalized.voicemail_used === true ||\n  normalized.voicemail_used === 'true' ||\n  metadata.features_usage?.voicemail_detection?.used === true;\n\n// Look for meaningful speech from the recipient\nconst meaningfulUserResponses = transcript.filter(entry => {\n  if (entry.role !== 'user') return false;\n\n  const message = String(entry.message ?? '').trim();\n\n  return (\n    message !== '' &&\n    message !== '...' &&\n    message !== '…' &&\n    message.toLowerCase() !== '[silence]'\n  );\n});\n\nconst humanResponded = meaningfulUserResponses.length > 0;\n\n// Find the reason supplied when end_call was invoked\nlet endCallReason = '';\n\nfor (const entry of transcript) {\n  for (const toolCall of entry.tool_calls ?? []) {\n    if (toolCall.tool_name !== 'end_call') continue;\n\n    try {\n      const args = JSON.parse(toolCall.params_as_json ?? '{}');\n      endCallReason = String(args.reason ?? '').trim();\n    } catch {\n      // Ignore malformed tool arguments\n    }\n  }\n}\n\nconst reasonLower = endCallReason.toLowerCase();\n\nconst noResponse =\n  reasonLower.includes('no response') ||\n  reasonLower.includes('did not respond') ||\n  reasonLower.includes('no answer') ||\n  reasonLower.includes('silence');\n\n// Require SMS fallback when:\n// 1. voicemail was explicitly detected, OR\n// 2. recipient never meaningfully responded and agent ended for no response\nconst needsSmsFallback =\n  voicemailUsed ||\n  (!humanResponded && noResponse);\n\nreturn [{\n  json: {\n    ...normalized,\n    delivery_evaluation: {\n      voicemail_used: voicemailUsed,\n      human_responded: humanResponded,\n      no_response: noResponse,\n      end_call_reason: endCallReason,\n      needs_sms_fallback: needsSmsFallback\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
